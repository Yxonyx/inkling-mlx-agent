{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "inkling-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inkling on oMLX",
      "options": { "baseURL": "http://127.0.0.1:17481/v1" },
      "models": {
        "inkling-mini": {
          "name": "Inkling 2 Mini oQ4e (local)",
          "limit": { "context": 16384, "output": 4096 }
        }
      }
    }
  },
  "agent": {
    "inkling-smoke": {
      "mode": "primary",
      "prompt": "Read the named file with the read tool and answer from its output.",
      "permission": {
        "*": "deny",
        "read": "allow"
      }
    },
    "inkling-edit-smoke": {
      "mode": "primary",
      "prompt": "Use the read and edit tools to change the named source file. Keep the change focused.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "edit": "allow",
        "external_directory": "deny"
      }
    }
  },
  "model": "inkling-local/inkling-mini"
}
